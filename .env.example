# ==============================================================================
# Care Connect - Frontend Environment Configuration (.env.example)
# ==============================================================================
# IMPORTANT: Only public, frontend-safe variables prefixed with NEXT_PUBLIC_ belong here.
# NEVER place database credentials, AWS secrets, private API keys, or JWT secrets in this file.
# ==============================================================================

# Application Branding
NEXT_PUBLIC_APP_NAME="Care Connect"
NEXT_PUBLIC_APP_DESCRIPTION="Healthcare & Community Care Connecting Platform"

# API Boundary Configuration
# NOTE: BACKEND NOT IMPLEMENTED YET.
# In this frontend presentation phase, the UI consumes typed mock data via lib/api/ abstractions.
# This variable serves as an explicit placeholder for the future NestJS REST API.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001/api"

# Feature Flags / Demo Mode
NEXT_PUBLIC_DEMO_MODE=true
